{
	"name": "pressgang-wp/{{theme_slug}}",
	"description": "A PressGang child theme.",
	"type": "wordpress-theme",
	"license": "MIT",
	"require": {
		"pressgang-wp/pressgang": "^2.0"
	},
	"require-dev": {
		"php-stubs/acf-pro-stubs": "^6.8",
		"php-stubs/woocommerce-stubs": "^11.0",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"extra": {
		"installer-paths": {
			"../../plugins/{$name}/": [
				"type:wordpress-plugin"
			],
			"../../themes/{$name}/": [
				"type:wordpress-theme"
			]
		}
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true,
			"phpstan/extension-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"{{theme_namespace}}\\": "src/"
		}
	},
	"scripts": {
		"check": [
			"@test:compat",
			"@phpstan"
		],
		"test:compat": "php -d error_reporting=E_ALL -d display_errors=1 -l functions.php",
		"phpstan": "phpstan analyse --memory-limit=1G"
	}
}
