{
    "name": "pressgang-wp/capstan",
    "description": "WP-CLI command package for PressGang WordPress themes.",
    "type": "wp-cli-package",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "symfony/process": "^7.0",
        "symfony/filesystem": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PressGang\\Capstan\\": "src/"
        },
        "files": [
            "capstan.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PressGang\\Capstan\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
